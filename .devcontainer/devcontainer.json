{
  "name": "Postern (Nix on Ubuntu)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "overrideCommand": false,
  "init": true,
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "capAdd": ["SYS_ADMIN"],
  "securityOpt": ["seccomp=unconfined"],
  "initializeCommand": "mkdir -p \"${localEnv:HOME}/.espressif\"",
  "runArgs": [
    "--group-add=dialout",
    "--device-cgroup-rule=c 188:* rmw",
    "--device-cgroup-rule=c 166:* rmw"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.espressif,target=/root/.espressif,type=bind",
    "source=/dev,target=/host-dev,type=bind"
  ],
  "containerEnv": {
    "NIX_CONFIG": "experimental-features = nix-command flakes",
    "DEVCONTAINER_WORKSPACE": "${containerWorkspaceFolder}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "jnoortheen.nix-ide",
        "editorconfig.editorconfig",
        "DavidAnson.vscode-markdownlint",
        "yzhang.markdown-all-in-one",
        "ms-vscode.cpptools",
        "ms-vscode.vscode-serial-monitor",
        "ms-python.python"
      ]
    }
  }
}
