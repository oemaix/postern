{
  "name": "postern (Other host)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "initializeCommand": "sh .devcontainer/require-host.sh other",
  "runArgs": [
    "--name", "postern-other",
    "--cap-add=SYS_ADMIN",
    "--security-opt", "seccomp=unconfined",
    "--device-cgroup-rule=c 188:* rmw",
    "--device-cgroup-rule=c 166:* rmw"
  ],
  "mounts": [
    "source=/dev,target=/host-dev,type=bind",
    "source=devcontainer-nix,target=/nix,type=volume",
    "source=${localEnv:HOME}/.config/git/config,target=/etc/gitconfig.host,type=bind,readonly",
    "source=${localEnv:HOME}/.config/gh,target=/home/dev/.config/gh,type=bind,readonly",
    "source=/etc/nix/nix.conf,target=/etc/nix/nix.conf,type=bind,readonly"
  ],
  "postCreateCommand": "sudo /opt/devcontainer/realize.sh \"$(id -un)\" private",
  "postStartCommand": "sudo /opt/devcontainer/serial-link.sh start",
  "customizations": {
    "vscode": {
      "extensions": [
        "jnoortheen.nix-ide",
        "editorconfig.editorconfig",
        "DavidAnson.vscode-markdownlint",
        "yzhang.markdown-all-in-one",
        "ms-vscode.cpptools",
        "ms-vscode.vscode-serial-monitor",
        "ms-python.python"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "Nix Develop",
        "terminal.integrated.profiles.linux": {
          "Nix Develop": {
            "path": "zsh",
            "args": ["-lc", "exec nix develop -c \"$(command -v zsh)\""],
            "overrideName": true,
            "icon": "terminal-linux"
          }
        }
      }
    }
  }
}
