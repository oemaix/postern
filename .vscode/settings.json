{
  "terminal.integrated.defaultProfile.linux": "Nix Develop",
  "terminal.integrated.defaultProfile.osx": "Nix Develop",
  "terminal.integrated.profiles.linux": {
    "Nix Develop": {
      "path": "nix",
      "args": ["develop", "${workspaceFolder}", "--command", "zsh"],
      "cwd": "${workspaceFolder}",
      "overrideName": true,
      "icon": "terminal-linux"
    }
  },
  "terminal.integrated.profiles.osx": {
    "Nix Develop": {
      "path": "nix",
      "args": ["develop", "${workspaceFolder}", "--command", "zsh"],
      "cwd": "${workspaceFolder}",
      "overrideName": true,
      "icon": "terminal-linux"
    }
  }
}
