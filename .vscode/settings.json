{
  "terminal.integrated.defaultProfile.linux": "Nix Develop",
  "terminal.integrated.defaultProfile.osx": "Nix Develop",
  "terminal.integrated.profiles.linux": {
    "Nix Develop": {
      "path": "zsh",
      "args": ["-lc", "exec nix develop -c \"$(command -v zsh)\""],
      "overrideName": true,
      "icon": "terminal-linux"
    }
  },
  "terminal.integrated.profiles.osx": {
    "Nix Develop": {
      "path": "zsh",
      "args": ["-lc", "exec nix develop -c \"$(command -v zsh)\""],
      "overrideName": true,
      "icon": "terminal-linux"
    }
  }
}
