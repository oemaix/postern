# M5Stamp Pico: ESP32-PICO-D4, 4 MB flash, no PSRAM (D-0008, D-0021).
# The Classic Bluetooth image does not fit the 1 MB factory partition.
# The large single-app table gives that partition 1.5 MB.
# Classic A2DP, external codec, AAC, and two stream endpoints (P-0018).
# CONFIG_I2C_ISR_IRAM_SAFE stays unset (P-0013).

CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=y
CONFIG_BT_A2DP_CODEC_AAC_ENABLED=y
CONFIG_BT_A2DP_SEP_NUM_MAX=2
